rules_version = '2';

// Paste this into the Firebase console: Firestore Database -> Rules -> Publish.
// This file is the source of truth; the console copy must match it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'nssharpe@gmail.com',
             'kadyn.z.sharpe@gmail.com'
           ];
    }

    match /collection/{lineId} {
      allow read, write: if isAllowedUser();
    }

    match /meta/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
